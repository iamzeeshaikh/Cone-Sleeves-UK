# dependencies
node_modules/

# build output
dist/
.vercel/
.astro/

# environment — never commit real credentials
.env
.env.*
!.env.example

# migration source material (reference only, not part of the deployable site)
_source/
src-images/
*.zip
*.sql
*.xml
wc-product-export-*.csv

# ...but anything under public/ is a deployable asset, not source material.
# The *.xml rule above was written for the WordPress export dumps and silently
# swallowed public/sitemap-recrawl.xml, which then never reached the build.
!public/**/*.xml

# macOS
.DS_Store
._*

# logs
npm-debug.log*
*.log
.vercel

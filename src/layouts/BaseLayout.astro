---
import '~/styles/global.css';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import FloatingContact from '~/components/FloatingContact.astro';
import { SITE, ANALYTICS, CHAT } from '~/config/site';
import { organisation, website } from '~/lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  schema?: unknown[];
  /** Names the current page in the WhatsApp prefilled message. */
  whatsappContext?: string;
  /** Preloads the LCP image where the page knows what it is. */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  image,
  imageAlt,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  schema = [],
  whatsappContext,
  preloadImage,
  bodyClass,
} = Astro.props;

// Organization and WebSite are part of every page's graph so the entity is
// consistent site-wide rather than declared differently per template.
const graph = [organisation(), website(), ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2b5a1e" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* The single font file is the only render-blocking asset worth preloading. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }

    <Seo
      title={title}
      description={description}
      path={path}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      schema={graph}
    />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} guides`} href="/rss.xml" />

    {
      /* Zendesk Chat. The snippet is inline but everything it does is
         asynchronous — it appends a script with async set — so it does not
         block the first paint. Emitted only when a key is configured. */
    }
    {
      CHAT.zendeskKey && (
        <script
          is:inline
          set:html={`window.$zopim||(function(d,s){var z=$zopim=function(c){z._.push(c)},$=z.s=d.createElement(s),e=d.getElementsByTagName(s)[0];z.set=function(o){z.set._.push(o)};z._=[];z.set._=[];$.async=!0;$.setAttribute('charset','utf-8');$.src='https://v2.zopim.com/?${CHAT.zendeskKey}';z.t=+new Date;$.type='text/javascript';e.parentNode.insertBefore($,e)})(document,'script');`}
        />
      )
    }

    {
      /* Analytics is only emitted when a real ID is configured. No invented
         measurement IDs are ever written into the HTML. */
    }
    {
      ANALYTICS.gtm && (
        <script
          type="text/partytown"
          is:inline
          set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${ANALYTICS.gtm}');`}
        />
      )
    }
    {
      ANALYTICS.ga4 && !ANALYTICS.gtm && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ANALYTICS.ga4}',{anonymize_ip:true});`}
          />
        </>
      )
    }
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact context={whatsappContext} />

    <script>
      // Conversion signals for phone, email, WhatsApp and form clicks.
      // These push to dataLayer only when a tag manager is actually present,
      // so nothing is sent anywhere by default.
      const w = window as unknown as { dataLayer?: unknown[] };
      if (Array.isArray(w.dataLayer)) {
        document.addEventListener('click', (e) => {
          const el = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
          if (!el) return;
          const href = el.getAttribute('href') ?? '';
          let event: string | null = null;
          if (href.startsWith('tel:')) event = 'phone_click';
          else if (href.startsWith('mailto:')) event = 'email_click';
          else if (href.includes('wa.me')) event = 'whatsapp_click';
          if (event) w.dataLayer!.push({ event });
        });
      }
    </script>
  </body>
</html>

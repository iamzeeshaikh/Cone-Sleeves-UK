---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Sections from '~/components/Sections.astro';
import Faqs from '~/components/Faqs.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import ProductCard from '~/components/ProductCard.astro';
import type { Category } from '~/data/types';
import { categoryPath, subcategoriesOf, categoryBySlug } from '~/data/categories';
import { productsInCategory, productsInSubcategory } from '~/data/products';
import { primaryImage } from '~/lib/images';
import { SITE } from '~/config/site';
import * as schema from '~/lib/schema';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const path = categoryPath(category);
const parent = category.parent ? categoryBySlug(category.parent) : undefined;
const subs = category.parent ? [] : subcategoriesOf(category.slug);

const products = category.parent
  ? productsInSubcategory(category.parent, category.slug)
  : productsInCategory(category.slug);

const hero = primaryImage(category.heroProduct);

const crumbs = [
  { name: 'Home', path: '/' },
  ...(parent ? [{ name: parent.name, path: categoryPath(parent) }] : []),
  { name: category.name, path },
];

const graph = [
  schema.breadcrumbs(path, crumbs),
  schema.webPage({
    path,
    name: category.seoTitle,
    description: category.seoDescription,
    type: 'CollectionPage',
    primaryImage: hero?.src,
    breadcrumbId: `${SITE.origin}${path}#breadcrumb`,
  }),
  schema.itemList(
    products.map((p) => ({ name: p.name, path: `/${p.slug}/` })),
    path,
  ),
  schema.faqPage(category.faqs, path),
];
---

<BaseLayout
  title={`${category.seoTitle} | Cone Sleeves UK`.length > 65
    ? category.seoTitle
    : `${category.seoTitle} | Cone Sleeves UK`}
  description={category.seoDescription}
  path={path}
  image={hero?.src}
  imageAlt={`${category.name} from Cone Sleeves UK`}
  schema={graph}
  whatsappContext={category.name.toLowerCase()}
>
  <Breadcrumbs crumbs={crumbs} />

  <section class="category-hero">
    <div class="wrap category-hero-grid">
      <div class="category-hero-copy">
        <p class="eyebrow">{parent ? `${parent.name} — ${category.name}` : 'Product range'}</p>
        <h1>{category.h1}</h1>
        {category.intro.map((p) => <p class="lede">{p}</p>)}
        <p class="category-count">
          {products.length} product{products.length === 1 ? '' : 's'} in this range
        </p>
      </div>
      {
        hero && (
          <div class="category-hero-media">
            <Image
              src={hero}
              alt={`${category.name} supplied by Cone Sleeves UK`}
              widths={[420, 640]}
              sizes="(min-width: 900px) 420px, 90vw"
              format="webp"
              quality={76}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </div>
        )
      }
    </div>
  </section>

  <div class="wrap category-quote">
    <QuoteForm
      requirementHint={category.name}
      source={`category:${category.slug}`}
      variant="panel"
      heading={`Quote for ${category.name}`}
      intro="Tell us what you serve and roughly how many you need. We reply with a specification, a minimum quantity and a lead time."
      id="quote"
    />
  </div>

  {
    subs.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <h2 class="subs-title">Browse {category.name} By</h2>
          <ul class="sub-nav">
            {subs.map((s) => (
              <li>
                <a href={categoryPath(s)}>
                  <strong>{s.name}</strong>
                  <span>{s.cardBlurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="wrap">
      <h2 id="products">{category.name} We Print</h2>
      <div class="grid-auto product-grid">
        {products.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="wrap category-guidance">
      <Sections sections={category.sections} />
      <Faqs faqs={category.faqs} heading={`${category.name}: Common Questions`} />
    </div>
  </section>
</BaseLayout>

<style>
  .category-hero {
    padding-block: var(--space-m) var(--space-l);
  }

  .category-hero-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
  }

  @media (max-width: 900px) {
    .category-hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .category-hero-media {
      order: -1;
    }
  }

  .category-hero-copy h1 {
    margin: 0.4rem 0 var(--space-s);
  }

  .category-hero-copy .lede + .lede {
    margin-top: 0.75rem;
  }

  .category-count {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--green-800);
    background: var(--green-050);
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
  }

  .category-hero-media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    aspect-ratio: var(--ratio-product);
    background: var(--surface-sunk);
  }

  .category-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .category-quote {
    padding-bottom: var(--space-l);
  }

  .subs-title {
    font-size: var(--step-2);
  }

  .sub-nav {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-2xs);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }

  .sub-nav a {
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--c-border-soft);
    border-radius: var(--radius-m);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }

  .sub-nav a:hover {
    border-color: var(--green-500);
    box-shadow: var(--shadow-s);
  }

  .sub-nav strong {
    color: var(--green-800);
    font-size: 0.98rem;
  }

  .sub-nav span {
    font-size: var(--step--1);
    color: var(--c-text-muted);
    line-height: 1.45;
  }

  .product-grid {
    margin-top: var(--space-m);
  }

  .category-guidance {
    max-width: 82ch;
  }
</style>

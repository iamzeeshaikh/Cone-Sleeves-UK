---
import Logo from './Logo.astro';
import { CONTACT, TEL_HREF } from '~/config/site';
import { TOP_CATEGORIES, subcategoriesOf, categoryPath } from '~/data/categories';
import { productsInCategory } from '~/data/products';

/**
 * Site header.
 *
 * Seven product ranges will not fit across a top bar alongside a call to
 * action, so the ranges live inside one "Products" mega panel rather than
 * being spread across the bar. That keeps every range link in the DOM on
 * every page while leaving the visible bar to six short items.
 *
 * The panel opens on hover and on keyboard focus using CSS alone. The only
 * JavaScript in the header is the mobile drawer, which has to manage focus
 * and the scroll lock behind it.
 */
const currentPath = Astro.url.pathname;

const ranges = TOP_CATEGORIES.map((c) => ({
  label: c.name,
  href: categoryPath(c),
  blurb: c.cardBlurb,
  count: productsInCategory(c.slug).length,
  children: subcategoriesOf(c.slug).map((s) => ({
    label: s.name,
    href: categoryPath(s),
  })),
}));

const links = [
  { label: 'Design tool', href: '/design-your-cone-sleeve/' },
  { label: 'Guides', href: '/blog/' },
  { label: 'Areas', href: '/locations/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));

/** The Products item highlights on any range, subcategory or product page. */
const onProducts =
  currentPath === '/products/' ||
  ranges.some((r) => currentPath.startsWith(r.href)) ||
  (!links.some((l) => currentPath.startsWith(l.href)) &&
    currentPath !== '/' &&
    !currentPath.startsWith('/blog/'));
---

<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <p class="topbar-msg">Printed packaging for UK food businesses — quotes by return</p>
      <a class="topbar-tel" href={TEL_HREF}>
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
          ><path
            d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1Z"
          ></path></svg
        >
        {CONTACT.phoneDisplay}
      </a>
    </div>
  </div>

  <div class="header-row">
    <div class="wrap header-inner">
      <a href="/" class="brand" aria-label="Cone Sleeves UK — home">
        <Logo />
      </a>

      <nav class="primary-nav" aria-label="Main">
        <ul>
          <li class="has-mega">
            <a href="/products/" aria-current={onProducts ? 'true' : undefined}>
              Products
              <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true" fill="none">
                <path d="M2 4.5 6 8.5l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </a>

            <div class="mega">
              <div class="mega-inner">
                <div class="mega-grid">
                  {
                    ranges.map((r) => (
                      <div class="mega-col">
                        <a class="mega-range" href={r.href}>
                          <span>{r.label}</span>
                          <em>{r.count}</em>
                        </a>
                        <p class="mega-blurb">{r.blurb}</p>
                        {r.children.length > 0 && (
                          <ul class="mega-subs">
                            {r.children.map((c) => (
                              <li>
                                <a href={c.href}>{c.label}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    ))
                  }
                </div>
                <div class="mega-foot">
                  <a class="mega-all" href="/products/">See the full catalogue</a>
                  <a class="btn btn-primary btn-sm" href="/design-your-cone-sleeve/">
                    Design your cone sleeve
                  </a>
                </div>
              </div>
            </div>
          </li>

          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={isActive(l.href) ? 'true' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-actions">
        <a class="btn btn-primary btn-sm header-cta" href="/request-a-quote/">Get a quote</a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          data-nav-toggle
        >
          <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="visually-hidden">Open menu</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <div class="mobile-nav-head">
      <span class="mobile-nav-title">Menu</span>
      <button type="button" class="nav-close" data-nav-close>
        <span aria-hidden="true">&times;</span>
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="mobile-list">
        {
          ranges.map((r) => (
            <li>
              {r.children.length ? (
                <details>
                  <summary>{r.label}</summary>
                  <ul>
                    <li>
                      <a href={r.href}>All {r.label.toLowerCase()}</a>
                    </li>
                    {r.children.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={r.href}>{r.label}</a>
              )}
            </li>
          ))
        }
        <li><a href="/products/">All products</a></li>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/faqs/">FAQs</a></li>
      </ul>
    </nav>
    <div class="mobile-nav-foot">
      <a class="btn btn-primary btn-block" href="/request-a-quote/">Get a quote</a>
      <a class="btn btn-outline btn-block" href={TEL_HREF}>Call {CONTACT.phoneDisplay}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--c-border-soft);
  }

  .topbar {
    background: var(--green-800);
    color: #fff;
    font-size: var(--step--1);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 38px;
  }

  .topbar-msg {
    margin: 0;
    opacity: 0.92;
  }

  .topbar-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .topbar-tel:hover {
    color: var(--amber-500);
  }

  @media (max-width: 700px) {
    .topbar-msg {
      display: none;
    }
    .topbar-inner {
      justify-content: center;
    }
  }

  /* The row is the positioning context for the full-width mega panel. */
  .header-row {
    position: relative;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 84px;
  }

  .brand {
    flex: none;
    display: block;
    line-height: 0;
  }

  .brand :global(svg) {
    height: 48px;
    width: auto;
  }

  .primary-nav {
    margin-left: auto;
  }

  .primary-nav > ul {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-s);
    color: var(--ink-700);
    font-size: 0.97rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current] {
    background: var(--green-050);
    color: var(--green-800);
  }

  .has-mega > a svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .has-mega:hover > a svg,
  .has-mega:focus-within > a svg {
    transform: rotate(180deg);
  }

  /* --- Mega panel --- */

  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding-top: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out),
      visibility var(--dur);
  }

  .has-mega:hover .mega,
  .has-mega:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mega-inner {
    width: min(100% - 2.5rem, var(--wrap));
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid var(--c-border-soft);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-l);
    padding: var(--space-m);
  }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-m) var(--space-l);
  }

  @media (max-width: 1240px) {
    .mega-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .mega-range {
    display: flex !important;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 !important;
    font-size: 1rem !important;
    font-weight: 700 !important;
    color: var(--green-800) !important;
    background: none !important;
  }

  .mega-range:hover span {
    text-decoration: underline;
  }

  .mega-range em {
    flex: none;
    font-style: normal;
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--amber-700);
    background: var(--amber-050);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
  }

  .mega-blurb {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--c-text-muted);
  }

  .mega-subs {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0 0 0 0.75rem;
    border-left: 2px solid var(--green-100);
    display: grid;
    gap: 0.1rem;
  }

  .mega-subs a {
    padding: 0.25rem 0.4rem !important;
    font-size: 0.88rem !important;
    font-weight: 500 !important;
    color: var(--ink-700) !important;
  }

  .mega-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--c-border-soft);
  }

  .mega-all {
    font-weight: 650 !important;
    color: var(--green-800) !important;
  }

  .mega-foot .btn {
    color: #fff !important;
    background: var(--green-700) !important;
  }

  /* --- Actions --- */

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .nav-toggle {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-m);
  }

  .nav-toggle-bars {
    display: grid;
    gap: 4px;
  }

  .nav-toggle-bars span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink-900);
    border-radius: 2px;
  }

  /* Six short items plus a button need roughly 940px alongside the logo. */
  @media (max-width: 1080px) {
    .primary-nav {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .header-actions {
      margin-left: auto;
    }
    .header-inner {
      min-height: 72px;
    }
  }

  @media (max-width: 560px) {
    .header-cta {
      display: none;
    }
    .brand :global(svg) {
      height: 40px;
    }
  }

  /* --- Mobile drawer --- */

  .mobile-nav {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(24rem, 100%);
    background: var(--surface);
    box-shadow: var(--shadow-l);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    z-index: 60;
    animation: slide-in var(--dur) var(--ease-out);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav {
      animation: none;
    }
  }

  .mobile-nav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--c-border-soft);
  }

  .mobile-nav-title {
    font-weight: 700;
  }

  .nav-close {
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    line-height: 1;
    background: transparent;
    border: 0;
    border-radius: var(--radius-s);
    color: var(--ink-700);
  }

  .mobile-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    flex: 1;
  }

  .mobile-list a,
  .mobile-list summary {
    display: block;
    padding: 0.85rem 0.75rem;
    min-height: 48px;
    border-radius: var(--radius-s);
    color: var(--ink-900);
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-list summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-list summary::-webkit-details-marker {
    display: none;
  }

  .mobile-list summary::after {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--green-700);
    border-bottom: 2px solid var(--green-700);
    transform: rotate(45deg);
    transition: transform var(--dur-fast);
  }

  .mobile-list details[open] > summary::after {
    transform: rotate(-135deg);
  }

  .mobile-list details ul {
    list-style: none;
    margin: 0 0 0.5rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--green-100);
  }

  .mobile-list details a {
    font-weight: 500;
    color: var(--ink-700);
  }

  .mobile-nav-foot {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.25rem 1.5rem;
    border-top: 1px solid var(--c-border-soft);
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>

<script>
  // The only script in the header: opening the drawer, returning focus, and
  // closing on Escape or on following a link.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]');

  if (toggle && drawer && closeBtn) {
    const open = () => {
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('nav-open');
      closeBtn.focus();
    };

    const close = () => {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open');
      toggle.focus();
    };

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) close();
    });

    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
  }
</script>

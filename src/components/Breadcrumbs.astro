---
import type { Crumb } from '~/lib/schema';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const last = crumbs.length - 1;
---

<nav class="breadcrumbs wrap" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((c, i) => (
        <li>
          {i === last ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={c.path}>{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

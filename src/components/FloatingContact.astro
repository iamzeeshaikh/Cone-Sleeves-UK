---
import { whatsappHref, TEL_HREF, CONTACT } from '~/config/site';

interface Props {
  /** Names the current product or page so the WhatsApp message arrives with context. */
  context?: string;
}

const { context } = Astro.props;
const href = whatsappHref(context);
---

{/* Bottom-left by convention across the portfolio, keeping the right-hand
    edge free for any chat widget added later. */}
<div class="floating-contact">
  <a
    class="fab fab-whatsapp"
    href={href}
    rel="noopener"
    data-track="whatsapp-click"
    aria-label="Message us on WhatsApp"
  >
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.3 4.8 4.9-1.3A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.1 15.1l-.3-.2-2.9.8.8-2.8-.2-.3A8.1 8.1 0 0 1 12.04 3.8Zm-3.5 4.2c-.2 0-.5.1-.7.4-.3.3-.9.9-.9 2.1s.9 2.4 1.1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3l-1.8-.9c-.3-.1-.5-.1-.6.1l-.8 1c-.2.2-.3.2-.6.1a6.6 6.6 0 0 1-3.3-2.9c-.2-.4 0-.5.2-.7l.4-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4Z"
      ></path>
    </svg>
  </a>
  <a class="fab fab-call" href={TEL_HREF} data-track="phone-click" aria-label={`Call ${CONTACT.phoneDisplay}`}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1Z"
      ></path>
    </svg>
  </a>
</div>

<style>
  .floating-contact {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: grid;
    gap: 0.6rem;
  }

  .fab {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: #fff;
    box-shadow: var(--shadow-m);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast);
  }

  .fab:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: var(--shadow-l);
  }

  .fab-whatsapp {
    background: #25d366;
  }

  .fab-call {
    background: var(--green-700);
  }

  /* The call button is redundant on desktop, where tel: links rarely work. */
  @media (min-width: 780px) {
    .fab-call {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .floating-contact {
      left: 0.75rem;
      bottom: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab:hover {
      transform: none;
    }
  }
</style>

---
/**
 * Brand mark. Inline SVG so it costs no request and stays sharp at any size.
 * The cone glyph and the green/amber pairing carry over the existing brand
 * identity; the wordmark is redrawn for the UK business.
 *
 * Drawn on a 48px grid so the wordmark has room to breathe at header size.
 */
interface Props {
  /** 'full' = mark + wordmark, 'mark' = glyph only (used by the mobile bar). */
  variant?: 'full' | 'mark';
  /** Inverts the wordmark for use on the dark green footer. */
  light?: boolean;
  class?: string;
}

const { variant = 'full', light = false, class: className = '' } = Astro.props;

const wordColour = light ? '#ffffff' : '#1f4415';
const ukColour = light ? '#f2a93b' : '#a86b06';
---

{
  variant === 'mark' ? (
    <svg
      class={className}
      width="48"
      height="48"
      viewBox="0 0 48 48"
      role="img"
      aria-label="Cone Sleeves UK"
      fill="none"
    >
      <rect width="48" height="48" rx="13" fill="#2b5a1e" />
      <path d="M24 38 15.6 17.4h16.8L24 38Z" fill="#f2a93b" />
      <path d="M16.4 19.4h15.2l-1.3 3.2H17.7l-1.3-3.2Z" fill="#fbe0ac" />
      <circle cx="24" cy="13.6" r="4.4" fill="#fbe0ac" />
    </svg>
  ) : (
    <svg
      class={className}
      width="252"
      height="48"
      viewBox="0 0 252 48"
      role="img"
      aria-label="Cone Sleeves UK"
      fill="none"
    >
      <rect width="48" height="48" rx="13" fill="#2b5a1e" />
      <path d="M24 38 15.6 17.4h16.8L24 38Z" fill="#f2a93b" />
      <path d="M16.4 19.4h15.2l-1.3 3.2H17.7l-1.3-3.2Z" fill="#fbe0ac" />
      <circle cx="24" cy="13.6" r="4.4" fill="#fbe0ac" />
      <text
        x="62"
        y="23"
        fill={wordColour}
        font-family="Inter, system-ui, sans-serif"
        font-size="20"
        font-weight="800"
        letter-spacing="-0.6"
      >
        Cone Sleeves
      </text>
      <text
        x="63"
        y="38"
        fill={ukColour}
        font-family="Inter, system-ui, sans-serif"
        font-size="9.5"
        font-weight="700"
        letter-spacing="3.05"
      >
        UNITED KINGDOM
      </text>
    </svg>
  )
}

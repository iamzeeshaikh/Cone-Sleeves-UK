---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProductCard from '~/components/ProductCard.astro';
import QuoteForm from '~/components/QuoteForm.astro';
import DesignPanel from '~/components/DesignPanel.astro';
import Sections from '~/components/Sections.astro';
import Faqs from '~/components/Faqs.astro';
import { ROUTED_CATEGORIES, HOME_CATEGORY, categoryPath } from '~/data/categories';
import { productsInCategory, PRODUCT_COUNT } from '~/data/products';
import { POSTS, postPath, readingTime } from '~/data/blog';
import { CITIES } from '~/data/locations';
import { primaryImage } from '~/lib/images';
import { whatsappHref, CONTACT, TEL_HREF } from '~/config/site';
import * as schema from '~/lib/schema';

/**
 * The homepage is also the cone sleeve category page.
 *
 * The brand, the domain and this page all target "custom cone sleeves UK".
 * Publishing a separate /cone-sleeves/ category page would have put two of
 * our own pages against each other for that head term, so the flagship range
 * — its product grid, its buyer guidance and its FAQs — lives here instead,
 * and /cone-sleeves/ 301s to this page.
 */
const path = '/';
const heroImage = primaryImage('custom-waffle-cone-sleeves')!;

const coneSleeves = productsInCategory('cone-sleeves');
const latestPosts = POSTS.slice(0, 3);
const homeCities = CITIES.slice(0, 10);

const graph = [
  schema.webPage({
    path,
    name: 'Custom Printed Cone Sleeves | Cone Sleeves UK',
    description:
      'Custom printed cone sleeves cut to the cones you already serve, for UK ice cream shops, dessert bars and street food traders.',
    type: 'CollectionPage',
    primaryImage: heroImage.src,
  }),
  schema.itemList(
    coneSleeves.map((p) => ({ name: p.name, path: `/${p.slug}/` })),
    path,
  ),
  // These are the same questions rendered as accordions further down.
  schema.faqPage(HOME_CATEGORY.faqs, path),
];
---

<BaseLayout
  title="Custom Cone Sleeves UK | Printed Cone Sleeve Supplier"
  description="Printed cone sleeves cut to the cones you already serve. Waffle, sugar, cake and savoury cone wraps for UK dessert and street food businesses."
  path={path}
  image={heroImage.src}
  imageAlt="Custom printed cone sleeve on a waffle cone"
  schema={graph}
  whatsappContext="custom printed cone sleeves"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">UK cone sleeve supplier</p>
        <h1>Custom Printed Cone Sleeves, Cut to Your Own Cones</h1>
        <p class="lede">
          A cone sleeve is the piece of packaging a customer holds for the whole time they
          are eating. We print them for ice cream shops, gelaterias, dessert bars and
          street food traders across the United Kingdom — sized from the cone you already
          buy rather than pulled from a stock list.
        </p>

        <div class="btn-row hero-cta">
          <a class="btn btn-primary" href="/design-your-cone-sleeve/">Design your cone sleeve</a>
          <a class="btn btn-outline" href="#quote">Get a quote</a>
        </div>

        <dl class="hero-stats">
          <div>
            <dt>Cone sleeve designs</dt>
            <dd>{coneSleeves.length}</dd>
          </div>
          <div>
            <dt>Products in total</dt>
            <dd>{PRODUCT_COUNT}</dd>
          </div>
          <div>
            <dt>Delivered</dt>
            <dd>UK-wide</dd>
          </div>
        </dl>
      </div>

      <div class="hero-media">
        <Image
          src={heroImage}
          alt="Custom printed cone sleeve wrapped around a waffle cone"
          widths={[420, 620, 840]}
          sizes="(min-width: 1000px) 480px, 88vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
        <div class="hero-badge">
          <strong>Sized from your product</strong>
          <span>Send a cone, cup or container and we cut the die to it</span>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap home-quote" id="quote">
    <QuoteForm
      requirementHint="Custom printed cone sleeves"
      source="homepage"
      variant="panel"
      heading="Get a Cone Sleeve Quote"
      intro="Tell us which cone you serve and roughly how many sleeves you need. We reply with the board, print and finish, plus the minimum quantity and lead time for your job."
      id="quote-form"
    />
  </div>

  <section class="section-tight">
    <div class="wrap">
      <DesignPanel category="cone-sleeves" heading="Design Your Cone Sleeve" />
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <h2>The Cone Sleeve Range</h2>
      <p class="section-lede">
        {coneSleeves.length} cone sleeve products covering the shapes sold across the UK dessert
        trade: standard waffle, sugar, cake and rolled cones, plus savoury cones used for
        chips and fried chicken.
      </p>
      <div class="grid-auto featured-grid">
        {coneSleeves.map((p, i) => <ProductCard product={p} eager={i < 4} />)}
      </div>
    </div>
  </section>

  <section class="section section-white">
    <div class="wrap home-guidance">
      <Sections sections={HOME_CATEGORY.sections} />
      <Faqs faqs={HOME_CATEGORY.faqs} heading="Cone Sleeves: Common Questions" />
    </div>
  </section>

  <section class="section-tight ranges">
    <div class="wrap">
      <h2>The Rest of What We Print</h2>
      <p class="section-lede">
        Six further ranges, each specified around a different problem — grease from a
        fryer, heat through a cup wall, or a bag that has to hold a full order.
      </p>
      <div class="range-grid">
        {
          ROUTED_CATEGORIES.map((c) => {
            const img = primaryImage(c.heroProduct);
            const count = productsInCategory(c.slug).length;
            return (
              <a class="range-card card" href={categoryPath(c)}>
                <div class="range-media">
                  {img && (
                    <Image
                      src={img}
                      alt={`${c.name} printed by Cone Sleeves UK`}
                      widths={[220, 400]}
                      sizes="(min-width: 900px) 240px, 45vw"
                      format="webp"
                      quality={70}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <div class="range-body">
                  <h3>{c.name}</h3>
                  <p>{c.cardBlurb}</p>
                  <span class="range-count">{count} products</span>
                </div>
              </a>
            );
          })
        }
      </div>
      <p class="all-products-link">
        <a class="btn btn-outline" href="/products/">See all {PRODUCT_COUNT} products</a>
      </p>
    </div>
  </section>

  <section class="section section-sunk">
    <div class="wrap how-grid">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>Four Steps, and None of Them Involve Guessing a Size</h2>
        <p class="section-lede">
          Almost every packaging order that goes wrong goes wrong at the measurement
          stage. We start there rather than with the artwork.
        </p>
        <a class="btn btn-primary" href="/request-a-quote/">Start an enquiry</a>
      </div>
      <ol class="how-steps">
        <li>
          <h3>Send the Cone</h3>
          <p>
            Post us two or three of the cones you use, or the top diameter and slant
            height. A physical sample removes every ambiguity at once.
          </p>
        </li>
        <li>
          <h3>Agree the Specification</h3>
          <p>
            Board, lining, print method, colours and finish, with the minimum quantity and
            lead time confirmed in writing on your quote.
          </p>
        </li>
        <li>
          <h3>Work on the Die Line</h3>
          <p>
            We supply a template cut to your cone, so artwork is built on the correct arc
            rather than adjusted to fit afterwards.
          </p>
        </li>
        <li>
          <h3>Approve, Print, Deliver</h3>
          <p>
            A digital proof on the die line, then production and dispatch on national
            carriers to any UK address.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-green honest">
    <div class="wrap honest-grid">
      <div>
        <p class="eyebrow">What we will not do</p>
        <h2>No Invented Lead Times, and No Claims We Cannot Back</h2>
        <p>
          Plenty of packaging websites publish a turnaround figure, a minimum order
          quantity and an environmental claim that apply to nothing in particular. We
          would rather put those on your quote, against your actual specification.
        </p>
      </div>
      <ul class="honest-list">
        <li>
          <strong>Lead times</strong>
          <span>Confirmed per job, because they move with the press schedule and run length.</span>
        </li>
        <li>
          <strong>Minimum quantities</strong>
          <span>Set by the print method your job needs, not by a single site-wide number.</span>
        </li>
        <li>
          <strong>Recycling claims</strong>
          <span>We tell you the board and lining; whether it is recycled depends on your collection.</span>
        </li>
        <li>
          <strong>Reviews and ratings</strong>
          <span>None published, because none have been independently collected.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap home-contact-grid">
      <div class="home-contact">
        <h2>Rather Talk It Through?</h2>
        <p>
          Sizing questions are usually quicker on the phone, especially with a cone in
          front of you.
        </p>
        <ul>
          <li><a href={TEL_HREF}>{CONTACT.phoneDisplay}</a></li>
          <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><a href={whatsappHref('custom printed cone sleeves')} rel="noopener">Message us on WhatsApp</a></li>
        </ul>
      </div>
      <div class="home-posts">
        <h2>Guides for Buyers</h2>
        <p class="section-lede">Written for people specifying packaging rather than selling it.</p>
        <div class="post-grid">
          {
            latestPosts.map((post) => (
              <a class="post-card card" href={postPath(post.slug)}>
                <span class="badge badge-amber">{post.topic}</span>
                <h3>{post.title}</h3>
                <span class="post-meta">{readingTime(post)} min read</span>
              </a>
            ))
          }
        </div>
        <p class="all-products-link">
          <a class="btn btn-outline btn-sm" href="/blog/">All guides</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight section-sunk">
    <div class="wrap">
      <h2 class="areas-title">Areas We Supply</h2>
      <p class="section-lede">
        We deliver anywhere in the UK. These pages cover what the food trade in each place
        actually buys.
      </p>
      <ul class="area-list">
        {homeCities.map((l) => <li><a href={`/${l.slug}/`}>{l.place}</a></li>)}
        <li><a href="/locations/">All areas</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-xl);
    background: linear-gradient(170deg, var(--green-050) 0%, var(--cream) 60%);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .hero-copy h1 {
    margin: 0.5rem 0 var(--space-s);
    font-size: var(--step-6);
    max-width: 16ch;
  }

  .hero-copy .lede {
    max-width: 54ch;
  }

  .hero-cta {
    margin-top: var(--space-m);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding-top: var(--space-m);
    border-top: 1px solid var(--green-100);
  }

  .hero-stats dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-text-muted);
    font-weight: 650;
  }

  .hero-stats dd {
    margin: 0.15rem 0 0;
    font-size: var(--step-3);
    font-weight: 750;
    color: var(--green-800);
    letter-spacing: -0.02em;
  }

  .hero-media {
    position: relative;
  }

  .hero-media :global(img) {
    width: 100%;
    aspect-ratio: var(--ratio-product);
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-l);
  }

  .hero-badge {
    position: absolute;
    left: -0.75rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.15rem;
    max-width: 17rem;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-m);
  }

  .hero-badge strong {
    font-size: 0.95rem;
    color: var(--green-800);
  }

  .hero-badge span {
    font-size: var(--step--1);
    color: var(--c-text-muted);
    line-height: 1.45;
  }

  @media (max-width: 520px) {
    .hero-badge {
      left: 0.5rem;
      right: 0.5rem;
      max-width: none;
    }
  }

  .home-quote {
    padding-block: var(--space-l);
  }

  .section-lede {
    margin-top: 0.5rem;
    max-width: 62ch;
    color: var(--c-text-soft);
  }

  .featured-grid {
    margin-top: var(--space-m);
  }

  .home-guidance {
    max-width: 82ch;
  }

  .range-grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    margin-top: var(--space-m);
  }

  .range-card {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    color: inherit;
  }

  .range-media {
    aspect-ratio: 4 / 3;
    background: var(--surface-sunk);
    overflow: hidden;
  }

  .range-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .range-body {
    padding: var(--space-s);
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .range-body h3 {
    font-size: var(--step-1);
  }

  .range-body p {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    line-height: 1.5;
  }

  .range-count {
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--green-700);
  }

  .all-products-link {
    margin-top: var(--space-m);
  }

  .how-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
  }

  @media (max-width: 900px) {
    .how-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .how-grid h2 {
    margin: 0.4rem 0 var(--space-s);
  }

  .how-grid .btn {
    margin-top: var(--space-m);
  }

  .how-steps {
    counter-reset: how;
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .how-steps li {
    counter-increment: how;
    position: relative;
    padding: var(--space-s) var(--space-s) var(--space-s) 3.75rem;
    background: var(--surface);
    border-radius: var(--radius-m);
  }

  .how-steps li::before {
    content: '0' counter(how);
    position: absolute;
    left: 1.1rem;
    top: 1.05rem;
    font-weight: 750;
    color: var(--amber-600);
    font-size: 1.1rem;
  }

  .how-steps h3 {
    font-size: var(--step-0);
    margin-bottom: 0.2rem;
  }

  .how-steps p {
    margin: 0;
    font-size: 0.93rem;
    color: var(--c-text-soft);
  }

  .honest-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: start;
  }

  @media (max-width: 900px) {
    .honest-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
    }
  }

  .honest-grid h2 {
    margin: 0.4rem 0 var(--space-s);
    max-width: 20ch;
  }

  .honest-grid > div > p {
    color: rgb(255 255 255 / 0.82);
    max-width: 52ch;
  }

  .honest-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .honest-list li {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-s);
    background: rgb(255 255 255 / 0.07);
    border-radius: var(--radius-m);
    border-left: 3px solid var(--amber-500);
  }

  .honest-list strong {
    color: #fff;
  }

  .honest-list span {
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.78);
    line-height: 1.5;
  }

  .home-contact-grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    align-items: start;
  }

  @media (max-width: 900px) {
    .home-contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .home-contact {
    padding: var(--space-m);
    background: var(--surface-sunk);
    border-radius: var(--radius-l);
  }

  .home-contact h2 {
    font-size: var(--step-2);
  }

  .home-contact p {
    margin-top: 0.5rem;
    color: var(--c-text-soft);
    font-size: 0.95rem;
  }

  .home-contact ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    gap: 0.4rem;
    font-weight: 650;
  }

  .home-posts h2 {
    font-size: var(--step-2);
  }

  .post-grid {
    display: grid;
    gap: var(--space-s);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    margin-top: var(--space-m);
  }

  .post-card {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: var(--space-s);
    text-decoration: none;
    color: inherit;
  }

  .post-card h3 {
    font-size: var(--step-0);
    line-height: 1.35;
  }

  .post-meta {
    font-size: var(--step--1);
    color: var(--c-text-muted);
  }

  .post-card .badge {
    justify-self: start;
  }

  .areas-title {
    font-size: var(--step-3);
  }

  .area-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .area-list a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--green-800);
  }

  .area-list a:hover {
    border-color: var(--green-500);
    background: var(--green-050);
  }
</style>

# ---------------------------------------------------------------------------
# Cone Sleeves UK — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# Variable NAMES only in this file — no credentials.
# ---------------------------------------------------------------------------

# --- Outgoing mail (quote forms, design tool, contact form) ----------------
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_TO=info@conesleeves.co.uk
SMTP_FROM_NAME=Cone Sleeves UK
SMTP_FROM_EMAIL=info@conesleeves.co.uk

# Optional second recipient for sales copies (comma-separated).
SMTP_CC=

# --- Form protection -------------------------------------------------------
# Max enquiry submissions allowed per IP inside the rate-limit window.
RATE_LIMIT_MAX=
# Rate-limit window in seconds.
RATE_LIMIT_WINDOW=
# Max accepted artwork upload size in megabytes.
MAX_UPLOAD_MB=

# --- Live chat -------------------------------------------------------------
# Zendesk Chat (Zopim) widget key. Public by design, not a secret.
# Blank this to remove the chat widget and the cookies it sets.
PUBLIC_ZENDESK_CHAT_KEY=

# --- Analytics and verification -------------------------------------------
# Leave blank to keep the tag out of the HTML entirely. No invented IDs.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_GSC_VERIFICATION=

# --- Business details pending confirmation before launch -------------------
# These render only when populated; nothing is invented in the templates.
PUBLIC_COMPANY_LEGAL_NAME=
PUBLIC_COMPANY_NUMBER=
PUBLIC_VAT_NUMBER=
PUBLIC_REGISTERED_ADDRESS=
PUBLIC_TRADING_ADDRESS=
